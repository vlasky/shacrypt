{
  "name": "@vlasky/shacrypt",
  "description": "Node.js wrapper over sha256-crypt and sha512-crypt functions originally created by Ulrich Drepper https://www.akkadia.org/drepper/SHA-crypt.txt",
  "version": "0.6.0",
  "homepage": "https://github.com/vlasky/shacrypt",
  "author": "Vlad Lasky <github@vladlasky.com> (https://github.com/vlasky/)",
  "contributors": [
    "Oleksiy Krivoshey <oleksiyk@gmail.com> (https://github.com/oleksiyk/)"
  ],
  "license": "MIT",
  "keywords": [
    "sha256-crypt",
    "sha512-crypt",
    "sha-crypt",
    "crypt",
    "password",
    "hash",
    "native",
    "node-api"
  ],
  "main": "shacrypt.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./shacrypt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "shacrypt.js",
    "index.d.ts",
    "binding.gyp",
    "src/",
    "prebuilds/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
    "prebuildify": "prebuildify --napi --strip",
    "pretest": "npm run build",
    "test": "mocha"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "mocha": "^11.8.0",
    "prebuildify": "^6.0.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "bugs": {
    "url": "https://github.com/vlasky/shacrypt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlasky/shacrypt.git"
  },
  "gypfile": true
}
